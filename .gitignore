*.bin
*.elf

# PROS
bin/
lib/
.vscode/
.cache/
compile_commands.json
temp.log
temp.errors
*.ini
.d/
# NOTE: project.pros must stay TRACKED -- it is the file the PROS CLI and the
# VS Code extension use to recognize this directory as a PROS project. Ignoring
# it means a fresh clone is not a PROS project until it is hand-restored.

docs/generated/

# Packaged release artifacts (built by CI, not committed)
hitlib@*.zip

# Editor/backup files
*.bak

# Python virtualenvs
.venv*/
venv/

# Python build artifacts
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# PyInstaller build output for pattern_studio (built by CI, not committed --
# the verified .spec file itself IS committed)
tools/pattern_studio/build/
tools/pattern_studio/dist/
/.claude
